{
    "name": "clairex-vscode",
    "icon": "./assets/claire-icon.png",
    "displayName": "ClaireX",
    "description": "Language support for .cx files — ClaireX framework",
    "version": "0.2.0",
    "publisher": "clairex",
    "license": "MIT",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "devDependencies": {
        "@types/vscode": "^1.80.0",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "@clairex/typescript-plugin": "0.1.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/yusuf-codes10/clairex-core"
    },
    "contributes": {
        "typescriptServerPlugins": [
            {
                "name": "@clairex/typescript-plugin",
                "enableForWorkspaceTypeScriptVersions": true
            }
        ],
        "configurationDefaults": {
            "files.associations": {
                "*.cx": "typescript"
            },
            "material-icon-theme.files.customClones": [
                {
                    "name": "claire",
                    "base": "typescript",
                    "color": "#722f37",
                    "fileExtensions": [
                        "cx"
                    ]
                }
            ]
        },
        "snippets": [
            {
                "language": "typescript",
                "path": "./snippets/claire.json"
            }
        ]
    }
}